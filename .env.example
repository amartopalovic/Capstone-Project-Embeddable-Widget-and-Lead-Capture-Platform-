# =============================================================================
# Embeddable Widget & Lead-Capture Platform - example environment
# =============================================================================
#
# STATUS: Stage 3 complete. The core runtime, MongoDB, Redis, session, email,
# encryption, and MFA values are read by code today; the rest remain
# forward-looking placeholders.
#
# Consumed as of Stage 3a: NODE_ENV, PORT, RELEASE, APP_BASE_URL, MONGODB_URI,
# MONGODB_DB_NAME, REDIS_URL, REDIS_KEY_PREFIX, SESSION_SECRET,
# SESSION_COOKIE_NAME, SESSION_IDLE_TTL_DAYS, SESSION_ABSOLUTE_TTL_DAYS,
# EMAIL_PROVIDER, BREVO_API_KEY, BREVO_SENDER_EMAIL, BREVO_SENDER_NAME,
# MAILPIT_SMTP_HOST, MAILPIT_SMTP_PORT, BREACH_CHECK_REMOTE,
# ENCRYPTION_MASTER_KEY, ENCRYPTION_KEY_VERSION, and TOTP_ISSUER. Every other
# variable is still a placeholder for the stage noted in its section header.
#
# For normal local development you do not need a .env file at all: Docker
# Compose supplies the container values, and apps/server falls back to local
# defaults. Copy this file to .env (git-ignored) only when you need overrides.
#
# There are no real credentials, keys, or tokens in this file, and there never
# must be. Placeholder values are written as `replace-me-...` or left empty.
#
# The stage that first consumes each group is noted in its header. Groups
# without a local default require no credentials for normal local development -
# blueprint 15.1 requires that provider adapters have deterministic fakes, so
# a developer never needs Brevo, Atlas, Upstash, or Render access to work
# locally.
# =============================================================================


# -----------------------------------------------------------------------------
# Core runtime (first used: Stage 1)
# -----------------------------------------------------------------------------
NODE_ENV=development
# Single Render Web Service in production; one Express process locally.
PORT=3000
# Public origin of the platform itself. Used for links in email and for cookie
# and CORS decisions. No trailing slash.
APP_BASE_URL=http://localhost:3000
# Origin of the separate-origin demo site. Deliberately a DIFFERENT origin from
# APP_BASE_URL so cross-origin behavior is exercised locally.
# apps/web serves on 5173; apps/demo serves on 5174.
DEMO_BASE_URL=http://localhost:5174
# Free-form release identifier; in production this matches the deployed commit.
RELEASE=local-dev


# -----------------------------------------------------------------------------
# MongoDB (first used: Stage 1 for the readiness probe and seed; models and
# migrations arrive in Stage 2)
# Local Docker Mongo runs as a single-member replica set, because the
# multi-document transactions the application depends on are unavailable on a
# standalone mongod.
# -----------------------------------------------------------------------------
# Two different URIs are correct depending on WHERE the process runs:
#
#   Inside Docker Compose (how apps/server normally runs), the replica set
#   member advertises itself as "mongo:27017", so replicaSet discovery works:
#     mongodb://mongo:27017/leadcapture?replicaSet=rs0
#   Compose sets this automatically; you do not need to set it yourself.
#
#   From the HOST (running the seed script or tests directly), the advertised
#   host name "mongo" is not resolvable, so topology discovery fails. Use a
#   direct connection instead. Transactions still work, because the target is
#   the replica set primary.
MONGODB_URI=mongodb://localhost:27017/leadcapture?directConnection=true
MONGODB_DB_NAME=leadcapture


# -----------------------------------------------------------------------------
# Redis (first used: Stage 1 for the readiness probe; key policy in Stage 2 and
# sessions in Stage 3)
# Sessions, shared rate limits, BullMQ, idempotency keys, short caches, SSE
# fan-out metadata, and quota counters.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Prefix for every key this application owns, so a shared Redis stays legible.
REDIS_KEY_PREFIX=lcp:dev


# -----------------------------------------------------------------------------
# Sessions, CSRF, and cryptography (first used: Stage 3a)
# -----------------------------------------------------------------------------
# Signs CSRF tokens, so a predictable value would let an attacker mint valid
# ones. Generate a long random value per environment and NEVER commit a real
# one. Outside development the server refuses to start if this is unset or
# still says `replace-me`; in development it falls back to a fixed, obviously
# insecure value so `docker compose up` needs no credentials.
SESSION_SECRET=replace-me-with-a-long-random-value
SESSION_COOKIE_NAME=lcp.sid
# 7 days of inactivity, 30 days absolute maximum (blueprint 4.2).
SESSION_IDLE_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30

# Application-level AES-256-GCM master key for encrypting readable secrets.
# First used in Stage 3b for the TOTP secret; Stage 9 reuses it for webhook
# signing secrets. Must decode to exactly 32 bytes. The key version travels
# with each ciphertext, so a rotated key can still read older values
# (blueprint 12.4). Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Outside development the server refuses to start without a real value.
# Application-level AES-256-GCM key for readable secrets (blueprint 12.4, 17).
# Protects TOTP seeds from Stage 3b and, from Stage 9, webhook signing secrets -
# blueprint 12.4 groups them explicitly, so Stage 9 introduced NO new key
# material and reuses this one. Every ciphertext records the key version that
# produced it, so a rotated master key can still read older values.
ENCRYPTION_MASTER_KEY=replace-me-with-a-base64-32-byte-key
ENCRYPTION_KEY_VERSION=1

# Retired keys that must stay readable, as `version:base64key`, comma separated.
# Rotating ENCRYPTION_MASTER_KEY WITHOUT moving the old key in here makes every
# stored webhook signing secret and TOTP seed permanently undecryptable - GCM is
# authenticated encryption and there is no partial recovery. See
# docs/secret-rotation.md before changing either of the two lines above.
ENCRYPTION_PREVIOUS_KEYS=

# Name shown beside the account in an authenticator app (Stage 3b).
TOTP_ISSUER=Lead Capture Platform

# HMAC key material used to derive the monthly rotating IP pseudonym. Raw IPs
# are never persisted (blueprint 9.4).
#
# Stage 11 derives two more values from this same secret, each behind its own
# domain separator so they cannot be related to one another: the marketing
# suppression key, which lets an unsubscribe outlive the contact it belonged to
# without storing the address, and the signature on unsubscribe and opt-in
# links. Rotating this value therefore invalidates every unsubscribe link
# already sitting in somebody's inbox, and makes existing suppression entries
# unmatchable - so it is not a routine rotation.
IP_HMAC_SECRET=replace-me-with-a-long-random-value


# -----------------------------------------------------------------------------
# Email - Brevo (first used: Stage 3a for auth email; expanded in Stage 9)
# Locally, mail is captured by Mailpit instead and no Brevo account is needed.
# -----------------------------------------------------------------------------
# One of: mailpit (local SMTP), brevo (real provider), capture (in-memory, for
# tests). Selecting brevo without an API key downgrades to capture and logs a
# warning rather than silently failing to send.
EMAIL_PROVIDER=mailpit
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.invalid
BREVO_SENDER_NAME=Lead Capture Platform
# 300 messages per provider day: 100 reserved for auth/privacy, at most 200 for
# side effects (blueprint 5.3).
BREVO_DAILY_BUDGET=300
BREVO_RESERVED_CRITICAL=100
BREVO_SIDE_EFFECT_CAP=200
# Local Mailpit SMTP capture.
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025


# -----------------------------------------------------------------------------
# Geo enrichment providers (first used: Stage 7)
# Provider A is attempted with a strict timeout, then provider B. If both fail,
# the submission is still stored without geo.
# -----------------------------------------------------------------------------
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co
GEO_PROVIDER_TIMEOUT_MS=1000
# Use deterministic fakes locally and in CI rather than calling real providers.
GEO_PROVIDER_MODE=fake


# -----------------------------------------------------------------------------
# Password breach checking (first used: Stage 3a)
# -----------------------------------------------------------------------------
# An offline list of known-breached passwords ALWAYS runs. Setting this to true
# additionally consults the Have I Been Pwned range API using k-anonymity, so
# only the first five characters of the password SHA-1 ever leave the process.
# It fails open, so an unreachable provider never blocks a password change.
# Off by default: blueprint 15.1 requires local development to need no external
# service, and CI must not depend on a third-party API.
BREACH_CHECK_REMOTE=false


# -----------------------------------------------------------------------------
# Webhooks (first used: Stage 9)
# HTTPS only in production; private, loopback, link-local, and metadata-service
# destinations are blocked to prevent SSRF (blueprint 12.4).
# -----------------------------------------------------------------------------
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=5
# Allow plain-HTTP and loopback webhook targets. MUST remain false outside
# local development.
WEBHOOK_ALLOW_INSECURE_TARGETS=false


# -----------------------------------------------------------------------------
# Error monitoring - Sentry (first used: Stage 13)
# -----------------------------------------------------------------------------
# Empty disables error monitoring entirely, which is the normal state locally
# and in every test. A DSN identifies a project and grants only the ability to
# SEND events - it is embedded in the browser bundle of every application that
# uses one - but it is still read from the environment rather than committed.
#
# The Sentry ENVIRONMENT is NODE_ENV and the RELEASE is RELEASE, deliberately
# reusing the two values the structured logger already stamps on every line, so
# a log line and a crash report cannot disagree about which build produced them
# (blueprint 16.1, 16.3).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# The browser half. Vite only exposes variables prefixed VITE_ to client code,
# which is the mechanism that keeps every server secret above out of the bundle.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_ENVIRONMENT=development
# Must match RELEASE, or a browser error and the API error that caused it land
# under two different releases and nobody connects them.
VITE_RELEASE=local-dev


# -----------------------------------------------------------------------------
# Operator diagnostics (first used: Stage 13)
# -----------------------------------------------------------------------------
# Who may read GET /api/v1/diagnostics (blueprint 16.4): a comma-separated list
# of email addresses, matched against the SIGNED-IN user. Deliberately not a
# shared token - a token is new secret material to store, rotate, and leak, and
# it authenticates a caller rather than a person. Empty means the surface is
# closed to everybody, including whoever deployed it.
PLATFORM_OPERATOR_EMAILS=


# -----------------------------------------------------------------------------
# The sandbox's Content Security Policy (first used: Stage 13)
# -----------------------------------------------------------------------------
# The demo page installs its widgets the way a customer does - one script tag
# fetched across an origin boundary - so its CSP has to name the API's origin.
# Build-time only, and read by apps/demo/vite.config.ts.
VITE_API_ORIGIN=http://localhost:3000


# -----------------------------------------------------------------------------
# Public demo sandbox (first used: Stage 12)
# -----------------------------------------------------------------------------
# The anonymous sandbox resets hourly and has email and outbound webhooks
# disabled so it cannot consume the shared provider allowance.
DEMO_ENABLED=true
DEMO_RESET_INTERVAL_MINUTES=60
DEMO_EMAIL_ENABLED=false
DEMO_WEBHOOKS_ENABLED=false


# -----------------------------------------------------------------------------
# Workspace usage limits (first used: Stage 4 meters; enforced from Stage 7)
# Public-demo hard limits per workspace (blueprint 4.10).
# -----------------------------------------------------------------------------
LIMIT_ACTIVE_WIDGETS_PER_WORKSPACE=10
LIMIT_USERS_PER_WORKSPACE=10
LIMIT_SUBMISSIONS_PER_WORKSPACE_MONTH=2000
LIMIT_INTERACTION_EVENTS_PER_WORKSPACE_MONTH=20000

# -----------------------------------------------------------------------------
# Public submission path (Stage 7)
# -----------------------------------------------------------------------------

# HMAC key material for the rotating IP pseudonym (blueprint 9.4).
# The raw IP is never stored; this key derives the pseudonym that is. A weak
# value would make those pseudonyms reversible by brute force over the IPv4
# space, so production refuses to start with this placeholder.
IP_HMAC_SECRET=replace-me-with-a-long-random-value

# IP-to-geo enrichment (blueprint 5.1, 7.3 step 8).
# Off by default outside production: ip-api's free endpoint allows 45 requests
# per minute per source address and excludes commercial use, so a test suite
# calling it would be both flaky and impolite. Neither provider needs an API
# key on its free tier, which is why none appears here.
GEO_ENABLED=false
GEO_TIMEOUT_MS=1500
