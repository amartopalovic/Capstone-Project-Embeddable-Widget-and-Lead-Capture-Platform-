# =============================================================================
# Embeddable Widget & Lead-Capture Platform - example environment
# =============================================================================
#
# STATUS: Stage 0 scaffolding. NOTHING here is wired up yet.
#
# No application code reads these variables today. This file exists now, before
# any service integration, so that the shape of required configuration is
# visible to an evaluator and so that .gitignore protects real .env files from
# the very first commit.
#
# Every value below is a PLACEHOLDER. There are no real credentials, keys,
# tokens, or endpoints in this file, and there never must be. Copy this file to
# `.env` (which is git-ignored) and fill in real local values once Stage 1
# creates the local Docker environment.
#
# The stage that first consumes each group is noted in its header. Groups
# without a local default require no credentials for normal local development -
# blueprint 15.1 requires that provider adapters have deterministic fakes, so
# a developer never needs Brevo, Atlas, Upstash, or Render access to work
# locally.
# =============================================================================


# -----------------------------------------------------------------------------
# Core runtime (first used: Stage 1)
# -----------------------------------------------------------------------------
NODE_ENV=development
# Single Render Web Service in production; one Express process locally.
PORT=3000
# Public origin of the platform itself. Used for links in email and for cookie
# and CORS decisions. No trailing slash.
APP_BASE_URL=http://localhost:3000
# Origin of the separate-origin demo site. Deliberately a DIFFERENT origin from
# APP_BASE_URL so cross-origin behavior is exercised locally.
DEMO_BASE_URL=http://localhost:3001
# Free-form release identifier; in production this matches the deployed commit.
RELEASE=local-dev


# -----------------------------------------------------------------------------
# MongoDB (first used: Stage 2)
# Local Docker Mongo must be configured to support the transaction behavior the
# application uses (a replica set), hence the replicaSet parameter below.
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/leadcapture?replicaSet=rs0
MONGODB_DB_NAME=leadcapture


# -----------------------------------------------------------------------------
# Redis (first used: Stage 2 for connection and key policy; Stage 3 for sessions)
# Sessions, shared rate limits, BullMQ, idempotency keys, short caches, SSE
# fan-out metadata, and quota counters.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Prefix for every key this application owns, so a shared Redis stays legible.
REDIS_KEY_PREFIX=lcp:dev


# -----------------------------------------------------------------------------
# Sessions, CSRF, and cryptography (first used: Stage 3)
# -----------------------------------------------------------------------------
# Server-side session signing secret. Generate a long random value per
# environment. NEVER commit a real value.
SESSION_SECRET=replace-me-with-a-long-random-value
SESSION_COOKIE_NAME=lcp.sid
# 7 days of inactivity, 30 days absolute maximum (blueprint 4.2).
SESSION_IDLE_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30

# Application-level AES-256-GCM master key for encrypting readable secrets
# (MFA seeds, webhook secrets). Rotatable, with an explicit version so old
# ciphertext stays readable during rotation (blueprint 12.4).
ENCRYPTION_MASTER_KEY=replace-me-with-a-base64-32-byte-key
ENCRYPTION_KEY_VERSION=1

# HMAC key material used to derive the monthly rotating IP pseudonym. Raw IPs
# are never persisted (blueprint 9.4).
IP_HMAC_SECRET=replace-me-with-a-long-random-value


# -----------------------------------------------------------------------------
# Email - Brevo (first used: Stage 3 for auth email; expanded in Stage 9)
# Locally, mail is captured by Mailpit instead and no Brevo account is needed.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=mailpit
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.invalid
BREVO_SENDER_NAME=Lead Capture Platform
# 300 messages per provider day: 100 reserved for auth/privacy, at most 200 for
# side effects (blueprint 5.3).
BREVO_DAILY_BUDGET=300
BREVO_RESERVED_CRITICAL=100
BREVO_SIDE_EFFECT_CAP=200
# Local Mailpit SMTP capture.
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025


# -----------------------------------------------------------------------------
# Geo enrichment providers (first used: Stage 7)
# Provider A is attempted with a strict timeout, then provider B. If both fail,
# the submission is still stored without geo.
# -----------------------------------------------------------------------------
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co
GEO_PROVIDER_TIMEOUT_MS=1000
# Use deterministic fakes locally and in CI rather than calling real providers.
GEO_PROVIDER_MODE=fake


# -----------------------------------------------------------------------------
# Webhooks (first used: Stage 9)
# HTTPS only in production; private, loopback, link-local, and metadata-service
# destinations are blocked to prevent SSRF (blueprint 12.4).
# -----------------------------------------------------------------------------
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=5
# Allow plain-HTTP and loopback webhook targets. MUST remain false outside
# local development.
WEBHOOK_ALLOW_INSECURE_TARGETS=false


# -----------------------------------------------------------------------------
# Error monitoring - Sentry (first used: Stage 13)
# Leave empty to disable. PII scrubbing runs before transmission.
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1


# -----------------------------------------------------------------------------
# Public demo sandbox (first used: Stage 12)
# -----------------------------------------------------------------------------
# The anonymous sandbox resets hourly and has email and outbound webhooks
# disabled so it cannot consume the shared provider allowance.
DEMO_ENABLED=true
DEMO_RESET_INTERVAL_MINUTES=60
DEMO_EMAIL_ENABLED=false
DEMO_WEBHOOKS_ENABLED=false


# -----------------------------------------------------------------------------
# Workspace usage limits (first used: Stage 4 meters; enforced from Stage 7)
# Public-demo hard limits per workspace (blueprint 4.10).
# -----------------------------------------------------------------------------
LIMIT_ACTIVE_WIDGETS_PER_WORKSPACE=10
LIMIT_USERS_PER_WORKSPACE=10
LIMIT_SUBMISSIONS_PER_WORKSPACE_MONTH=2000
LIMIT_INTERACTION_EVENTS_PER_WORKSPACE_MONTH=20000
