{
  "name": "@lcp/server",
  "version": "0.1.0",
  "private": true,
  "description": "Express API, static serving, SSE, and worker bootstrap.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "seed": "tsx src/scripts/seed.ts",
    "test": "vitest run",
    "migrate": "tsx src/scripts/migrate.ts"
  },
  "dependencies": {
    "@lcp/contracts": "*",
    "@lcp/database": "*",
    "@lcp/widget-runtime": "*",
    "@node-rs/argon2": "^2.1.0",
    "bullmq": "^6.3.2",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "express": "^5.1.0",
    "ioredis": "^5.9.0",
    "mongodb": "^6.21.0",
    "nodemailer": "^9.0.6",
    "otpauth": "^9.5.1"
  },
  "devDependencies": {
    "@lcp/config": "*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  }
}
