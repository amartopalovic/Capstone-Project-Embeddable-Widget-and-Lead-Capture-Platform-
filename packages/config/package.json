{
  "name": "@lcp/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript, lint, format, test, and build configuration consumed by every workspace.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.node.json": "./tsconfig.node.json",
    "./tsconfig.browser.json": "./tsconfig.browser.json",
    "./eslint": "./eslint.shared.js",
    "./vitest": "./vitest.shared.js",
    "./prettier": "./prettier.shared.json"
  },
  "files": [
    "tsconfig.base.json",
    "tsconfig.node.json",
    "tsconfig.browser.json",
    "eslint.shared.js",
    "vitest.shared.js",
    "prettier.shared.json"
  ],
  "scripts": {
    "build": "echo \"@lcp/config publishes static config files; nothing to compile.\"",
    "typecheck": "echo \"@lcp/config contains no TypeScript sources.\""
  }
}
